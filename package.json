{
  "name": "physim",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:toy": "tsc && vite build --config vite.toy.config.ts",
    "pack:toy": "npm run build:toy && node scripts/pack-toy.mjs",
    "preview": "vite preview",
    "test:analysis": "node --experimental-strip-types src/analysis/motionAnalysis.selftest.ts",
    "test:fields": "node --experimental-strip-types src/engine/fields/fieldSystem.selftest.ts",
    "test:expr": "node --experimental-strip-types src/engine/forceExpr.selftest.ts",
    "test": "npm run test:analysis && npm run test:fields && npm run test:expr && npm run test:rigid",
    "test:physics": "node scripts/physics-check.mjs",
    "test:rigid": "node src/engine/rigid.selftest.js",
    "test:ui": "node scripts/ui-check.mjs && node scripts/display-check.mjs",
    "test:display": "node scripts/display-check.mjs"
  },
  "devDependencies": {
    "@types/jquery": "^4.0.1",
    "@types/three": "^0.170.0",
    "playwright": "^1.49.1",
    "typescript": "~5.9.0",
    "vite": "^6.3.5"
  },
  "dependencies": {
    "@dimforge/rapier2d-compat": "^0.21.0",
    "@pie-framework/mathquill": "^1.1.4",
    "jquery": "^4.0.0",
    "three": "^0.170.0"
  }
}
